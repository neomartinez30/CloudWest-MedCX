{
  "Version": "2019-10-30",
  "StartAction": "Welcome",
  "Metadata": {
    "entryPointPosition": {"x": 20, "y": 20},
    "ActionMetadata": {
      "Welcome": {"position": {"x": 180, "y": 20}},
      "InvokeLambdaIdentity": {"position": {"x": 420, "y": 20}},
      "SetContactAttributes": {"position": {"x": 660, "y": 20}},
      "PersonalizedGreeting": {"position": {"x": 900, "y": 20}},
      "ConversationLoop": {"position": {"x": 180, "y": 200}},
      "CheckAction": {"position": {"x": 420, "y": 200}},
      "ContinueConversation": {"position": {"x": 660, "y": 200}},
      "TransferToQueue": {"position": {"x": 900, "y": 200}},
      "PlayConfirmation": {"position": {"x": 180, "y": 380}},
      "OfferMore": {"position": {"x": 420, "y": 380}},
      "OfferSMS": {"position": {"x": 660, "y": 380}},
      "GetSMSConsent": {"position": {"x": 900, "y": 380}},
      "SendSMSLink": {"position": {"x": 180, "y": 560}},
      "PlaySMSConfirmation": {"position": {"x": 420, "y": 560}},
      "PlayHoldMessage": {"position": {"x": 660, "y": 560}},
      "PlayError": {"position": {"x": 900, "y": 560}},
      "DisconnectHangup": {"position": {"x": 180, "y": 740}},
      "EndCall": {"position": {"x": 420, "y": 740}}
    }
  },
  "Actions": [
    {
      "Identifier": "Welcome",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you for calling CloudWest Medical Center."
      },
      "Transitions": {
        "NextAction": "InvokeLambdaIdentity",
        "Errors": [
          {"NextAction": "PersonalizedGreeting", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "InvokeLambdaIdentity",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "REPLACE_WITH_IDENTITY_RESOLVER_ARN",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "action": "resolveByPhone",
          "phoneNumber": "$.CustomerEndpoint.Address"
        }
      },
      "Transitions": {
        "NextAction": "SetContactAttributes",
        "Errors": [
          {"NextAction": "PersonalizedGreeting", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "SetContactAttributes",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "patientId": "$.External.patientId",
          "patientName": "$.External.firstName",
          "isNewPatient": "$.External.isNewPatient",
          "conversationHistory": "[]"
        }
      },
      "Transitions": {
        "NextAction": "PersonalizedGreeting",
        "Errors": [
          {"NextAction": "PersonalizedGreeting", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "PersonalizedGreeting",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Hi $.Attributes.patientName! I'm your virtual assistant powered by AI. How can I help you today?"
      },
      "Transitions": {
        "NextAction": "ConversationLoop",
        "Errors": [
          {"NextAction": "ConversationLoop", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "ConversationLoop",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "LexBot": {
          "Name": "MedCXConversationalBot",
          "Region": "us-east-1",
          "Alias": "live"
        },
        "LexSessionAttributes": {
          "patientId": "$.Attributes.patientId",
          "patientName": "$.Attributes.patientName",
          "phoneNumber": "$.CustomerEndpoint.Address",
          "channel": "voice"
        }
      },
      "Transitions": {
        "NextAction": "CheckAction",
        "Errors": [
          {"NextAction": "PlayError", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "CheckAction",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Lex.SessionAttributes.nextAction"
      },
      "Transitions": {
        "NextAction": "ContinueConversation",
        "Conditions": [
          {
            "NextAction": "TransferToQueue",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["transfer_to_agent"]
            }
          },
          {
            "NextAction": "PlayConfirmation",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["completed"]
            }
          },
          {
            "NextAction": "OfferSMS",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["send_sms"]
            }
          },
          {
            "NextAction": "DisconnectHangup",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["end_call"]
            }
          },
          {
            "NextAction": "ContinueConversation",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["continue"]
            }
          }
        ],
        "Errors": [
          {"NextAction": "ContinueConversation", "ErrorType": "NoMatchingError"},
          {"NextAction": "ContinueConversation", "ErrorType": "NoMatchingCondition"}
        ]
      }
    },
    {
      "Identifier": "ContinueConversation",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.assistantResponse"
      },
      "Transitions": {
        "NextAction": "ConversationLoop",
        "Errors": [
          {"NextAction": "ConversationLoop", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "PlayConfirmation",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.assistantResponse"
      },
      "Transitions": {
        "NextAction": "OfferMore",
        "Errors": [
          {"NextAction": "DisconnectHangup", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "OfferMore",
      "Type": "GetParticipantInput",
      "Parameters": {
        "Text": "Is there anything else I can help you with today?",
        "InputTimeLimitSeconds": "8",
        "DTMF": {
          "InputTimeLimitSeconds": "5"
        }
      },
      "Transitions": {
        "NextAction": "ConversationLoop",
        "Conditions": [
          {
            "NextAction": "DisconnectHangup",
            "Condition": {
              "Operator": "TextContains",
              "Operands": ["no", "that's all", "nothing", "bye", "goodbye", "I'm good", "all set"]
            }
          }
        ],
        "Errors": [
          {"NextAction": "DisconnectHangup", "ErrorType": "NoMatchingError"},
          {"NextAction": "DisconnectHangup", "ErrorType": "InputTimeLimitExceeded"}
        ]
      }
    },
    {
      "Identifier": "OfferSMS",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.Lex.SessionAttributes.assistantResponse"
      },
      "Transitions": {
        "NextAction": "GetSMSConsent",
        "Errors": [
          {"NextAction": "TransferToQueue", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "GetSMSConsent",
      "Type": "GetParticipantInput",
      "Parameters": {
        "Text": "Would you like me to send that to your phone via text message?",
        "InputTimeLimitSeconds": "8"
      },
      "Transitions": {
        "NextAction": "TransferToQueue",
        "Conditions": [
          {
            "NextAction": "SendSMSLink",
            "Condition": {
              "Operator": "TextContains",
              "Operands": ["yes", "yeah", "sure", "okay", "ok", "please", "send it"]
            }
          },
          {
            "NextAction": "OfferMore",
            "Condition": {
              "Operator": "TextContains",
              "Operands": ["no", "nope", "don't", "not"]
            }
          }
        ],
        "Errors": [
          {"NextAction": "OfferMore", "ErrorType": "NoMatchingError"},
          {"NextAction": "OfferMore", "ErrorType": "InputTimeLimitExceeded"}
        ]
      }
    },
    {
      "Identifier": "SendSMSLink",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "REPLACE_WITH_CHANNEL_ROUTER_ARN",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "action": "sendHandoffSMS",
          "patientId": "$.Attributes.patientId",
          "phoneNumber": "$.CustomerEndpoint.Address",
          "context": "$.Lex.SessionAttributes.smsContext"
        }
      },
      "Transitions": {
        "NextAction": "PlaySMSConfirmation",
        "Errors": [
          {"NextAction": "PlayError", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "PlaySMSConfirmation",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I've sent you a text message. You can continue there whenever you're ready."
      },
      "Transitions": {
        "NextAction": "OfferMore",
        "Errors": [
          {"NextAction": "DisconnectHangup", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "TransferToQueue",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I'll connect you with one of our team members now."
      },
      "Transitions": {
        "NextAction": "SetQueueAttributes",
        "Errors": [
          {"NextAction": "SetQueueAttributes", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "SetQueueAttributes",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "conversationSummary": "$.Lex.SessionAttributes.conversationSummary",
          "transferReason": "$.Lex.SessionAttributes.transferReason"
        }
      },
      "Transitions": {
        "NextAction": "TransferToQueueAction",
        "Errors": [
          {"NextAction": "TransferToQueueAction", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "TransferToQueueAction",
      "Type": "TransferContactToQueue",
      "Parameters": {
        "QueueId": "REPLACE_WITH_QUEUE_ARN"
      },
      "Transitions": {
        "NextAction": "PlayHoldMessage",
        "Errors": [
          {"NextAction": "PlayError", "ErrorType": "NoMatchingError"},
          {"NextAction": "PlayError", "ErrorType": "QueueAtCapacity"}
        ]
      }
    },
    {
      "Identifier": "PlayHoldMessage",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Please hold while I connect you. Your estimated wait time is less than two minutes."
      },
      "Transitions": {
        "NextAction": "HoldLoop",
        "Errors": [
          {"NextAction": "DisconnectHangup", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "HoldLoop",
      "Type": "Loop",
      "Parameters": {
        "LoopCount": "10"
      },
      "Transitions": {
        "NextAction": "PlayError",
        "Conditions": [
          {
            "NextAction": "PlayHoldMusic",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["ContinueLooping"]
            }
          }
        ]
      }
    },
    {
      "Identifier": "PlayHoldMusic",
      "Type": "Loop",
      "Parameters": {
        "LoopCount": "1"
      },
      "Transitions": {
        "NextAction": "HoldLoop"
      }
    },
    {
      "Identifier": "PlayError",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I apologize, but I'm having some technical difficulties. Let me connect you with someone who can help."
      },
      "Transitions": {
        "NextAction": "TransferToQueueAction",
        "Errors": [
          {"NextAction": "DisconnectHangup", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "DisconnectHangup",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you for calling CloudWest Medical Center. Take care and have a wonderful day!"
      },
      "Transitions": {
        "NextAction": "EndCall",
        "Errors": [
          {"NextAction": "EndCall", "ErrorType": "NoMatchingError"}
        ]
      }
    },
    {
      "Identifier": "EndCall",
      "Type": "DisconnectParticipant",
      "Parameters": {}
    }
  ]
}
