{
  "name": "MedCXConversationalBot",
  "description": "GenAI-powered conversational medical assistant using Amazon Bedrock",
  "roleArn": "REPLACE_WITH_LEX_SERVICE_ROLE_ARN",
  "dataPrivacy": {
    "childDirected": false
  },
  "idleSessionTTLInSeconds": 300,
  "botLocales": [
    {
      "localeId": "en_US",
      "nluIntentConfidenceThreshold": 0.3,
      "voiceSettings": {
        "voiceId": "Joanna",
        "engine": "neural"
      },
      "intents": [
        {
          "name": "ConversationalIntent",
          "description": "Main conversational intent - delegates all NLU to Bedrock/Claude",
          "sampleUtterances": [
            {"utterance": "I need help"},
            {"utterance": "hello"},
            {"utterance": "hi"},
            {"utterance": "yes"},
            {"utterance": "no"},
            {"utterance": "schedule"},
            {"utterance": "appointment"},
            {"utterance": "cancel"},
            {"utterance": "reschedule"},
            {"utterance": "pay"},
            {"utterance": "bill"},
            {"utterance": "refill"},
            {"utterance": "prescription"},
            {"utterance": "agent"},
            {"utterance": "person"},
            {"utterance": "help"},
            {"utterance": "{UserInput}"}
          ],
          "slots": [
            {
              "name": "UserInput",
              "slotTypeName": "AMAZON.FreeFormInput",
              "valueElicitationSetting": {
                "slotConstraint": "Required",
                "promptSpecification": {
                  "messageGroups": [
                    {
                      "message": {
                        "plainTextMessage": {
                          "value": "How can I help you today?"
                        }
                      }
                    }
                  ],
                  "maxRetries": 5,
                  "allowInterrupt": true
                }
              }
            }
          ],
          "dialogCodeHook": {
            "enabled": true
          },
          "fulfillmentCodeHook": {
            "enabled": true,
            "fulfillmentUpdatesSpecification": {
              "active": true,
              "startResponse": {
                "delayInSeconds": 0,
                "messageGroups": [
                  {
                    "message": {
                      "plainTextMessage": {
                        "value": "Let me check that for you..."
                      }
                    }
                  }
                ],
                "allowInterrupt": true
              },
              "updateResponse": {
                "frequencyInSeconds": 1,
                "messageGroups": [
                  {
                    "message": {
                      "plainTextMessage": {
                        "value": "Still working on it..."
                      }
                    }
                  }
                ],
                "allowInterrupt": true
              },
              "timeoutInSeconds": 30
            }
          }
        },
        {
          "name": "FallbackIntent",
          "description": "Fallback - also handled by GenAI",
          "parentIntentSignature": "AMAZON.FallbackIntent",
          "dialogCodeHook": {
            "enabled": true
          },
          "fulfillmentCodeHook": {
            "enabled": true
          }
        }
      ]
    }
  ]
}
