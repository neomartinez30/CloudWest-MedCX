{
  "name": "cloudwest-medcx",
  "version": "1.0.0",
  "description": "Next Generation Medical Contact Center with AWS",
  "main": "infrastructure/bin/medcx-app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:phase1": "cdk deploy MedCX-Phase1-Foundation",
    "deploy:phase2": "cdk deploy MedCX-Phase2-Patient360",
    "deploy:phase3": "cdk deploy MedCX-Phase3-Omnichannel",
    "deploy:phase4": "cdk deploy MedCX-Phase4-GenAI",
    "deploy:phase5": "cdk deploy MedCX-Phase5-DocumentsPayments",
    "deploy:phase6": "cdk deploy MedCX-Phase6-Dashboard",
    "deploy:phase7": "cdk deploy MedCX-Phase7-Marketing",
    "deploy:all": "cdk deploy --all",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "lambda:build": "cd lambdas && npm run build",
    "dashboard:build": "cd dashboard && npm run build",
    "dashboard:dev": "cd dashboard && npm run dev"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0",
    "@aws-cdk/aws-lambda-python-alpha": "^2.120.0-alpha.0",
    "source-map-support": "^0.5.21",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "aws-cdk": "^2.120.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
